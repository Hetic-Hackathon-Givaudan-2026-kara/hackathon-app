{
  "name": "hackathon",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w api\" \"npm run dev -w web\"",
    "build": "npm run build --workspaces && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "format": "prettier --write . '!db/data'",
    "format:check": "prettier --check . '!db/data'",
    "seed:catalog": "tsx scripts/seed-catalog.ts",
    "test:search": "tsx scripts/test-search.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,css}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
